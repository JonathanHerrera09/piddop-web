# Base URL del backend, incluyendo /api/v1. Nunca agregues secretos a este archivo.
VITE_API_URL=http://localhost:3000/api/v1

# Public links used by the browser download buttons. Configure these when the
# Windows installer and Android APK have been uploaded to your hosting.
VITE_DESKTOP_DOWNLOAD_URL=
VITE_MOBILE_DOWNLOAD_URL=

# Opcional. Si se omite, se calcula desde VITE_API_URL cuando se integre tiempo real.
VITE_SOCKET_URL=

# Solo se usa al implementar los editores geográficos (Fase 7 y 9).
VITE_GOOGLE_MAPS_API_KEY=
